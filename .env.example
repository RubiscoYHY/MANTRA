# Copy to .env and fill in the keys you have. All three entry points
# (main.py, mantra CLI, mantragui) load this file automatically at startup.
# .env is gitignored — keys never leave your machine.

# ----- LLM providers (set the ones you use) -----
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=

# ----- Data vendors (active) -----
# News (default vendor; free key at alphavantage.co, 25 req/day)
ALPHA_VANTAGE_API_KEY=
# Earnings call transcripts (free key at api-ninjas.com)
API_NINJAS_KEY=
# SEC EDGAR requires a User-Agent identifying you, e.g. "Your Name you@example.com".
# Optional — a project default is used when unset, but your own contact is politer.
EDGAR_USER_AGENT=

# ----- Reserved for the News Lake (Phase 2.5 — NOT wired into the code yet) -----
# Free keys available; collectors will read these once Phase 2.5 is implemented.
# polygon.io — free 5 req/min, ticker-level news sentiment (best free quality)
POLYGON_API_KEY=
# tiingo.com — free, ticker-tagged news stream (no sentiment; feeds FinBERT)
TIINGO_API_KEY=
# marketaux.com — free 100 req/day (3 articles per request)
MARKETAUX_API_TOKEN=
